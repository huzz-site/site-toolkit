{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/huzz-site/site-toolkit/v1/schemas/site.schema.json",
  "title": "Site Toolkit site configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "displayName",
    "template",
    "templateVersion",
    "packageManager",
    "build",
    "healthChecks"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "template": { "const": "vue" },
    "templateVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "packageManager": { "const": "pnpm" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args", "output"],
      "properties": {
        "command": { "const": "pnpm" },
        "args": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "output": { "type": "string", "minLength": 1 }
      }
    },
    "healthChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    }
  }
}
