{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/huzz-site/site-toolkit/v1/schemas/workspace.schema.json",
  "title": "Site Toolkit workspace configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "organization", "cloudflare"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "organization": { "const": "huzz-site" },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "accountName"],
      "properties": {
        "accountId": { "type": "string", "minLength": 1 },
        "accountName": { "type": "string", "minLength": 1 }
      }
    }
  }
}
